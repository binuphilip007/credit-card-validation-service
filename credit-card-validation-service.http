@creditCardValidationBaseUrl = http://localhost:9090/host/credit-card-payment-api

### Validate payment status - approved
# @name validateApprovedPayment
POST {{creditCardValidationBaseUrl}}/payment-status
Content-Type: application/json

{
  "paymentReference": "CC123456789"
}

### Validate payment status - rejected
# @name validateRejectedPayment
POST {{creditCardValidationBaseUrl}}/payment-status
Content-Type: application/json

{
  "paymentReference": "CC987654321"
}

### Validate payment status - unknown reference
# @name validateUnknownPayment
POST {{creditCardValidationBaseUrl}}/payment-status
Content-Type: application/json

{
  "paymentReference": "CC000000000"
}

### Validate payment status - blank reference
# @name validateBlankPayment
POST {{creditCardValidationBaseUrl}}/payment-status
Content-Type: application/json

{
  "paymentReference": ""
}

### Validate payment status - missing reference
# @name validateMissingPaymentReference
POST {{creditCardValidationBaseUrl}}/payment-status
Content-Type: application/json

{}